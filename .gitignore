.venv/
__pycache__/
runs/
runs_d2/
# C4 -- D2's design at 300 000 steps (results/PREREGISTRATION_C4.md). The agents
# live only on the machine that trained them, like runs/ and runs_d2/.
runs_c4/
# Renamed 21 Sep 2026: the two agents in here were trained on the invented
# six-speed gearbox that 27e720c replaced. Moved aside so `train.py --seed 0`
# cannot resume into them and overwrite the only record of results/
# phase_d_seed0.txt. See AUDIT2.md C2-1.
runs_sixspeed_18sep/
*.zip

# the app writes exactly one file, and it is per-drive, not source
app/review_log.jsonl
app/node_modules/
app/static/vendor/

# Agent replay M3 (docs/superpowers/specs/2026-09-28-agent-replay-m3-design.md,
# section 7.3 and section 10 step 1). A jev key lives only in the
# TYPESAFE_API_KEY variable or in <APPDATA>/grad-project/typesafe_key, outside
# the repository. These patterns are a second line of defence, added before
# any key exists, so a copy made by mistake is never committed.
.env
.env.*
*typesafe_key*

# Per-step agent records (record_agents.py, train.py): 85 MB of binaries, kept
# on disk and NOT in git -- the team's decision, 29 September 2026. What is
# committed for every agent: config, curve, policy weights, eval_summary.json
# (which carries the statistics the page and the README read), README, figures.
results/agents/**/train_record.npz
results/agents/**/eval_record.npz
# The same rule for every other script's per-step records (step_record.py,
# 7 October 2026): the conditions test, the knock margin, the diagnostics, and
# the training roads regenerated beside each train_record.npz (training_roads.py).
results/records/
results/agents/**/train_roads.npz

# conditions_test.py's working files (7 October 2026): one part per condition,
# merged into results/conditions_test.json, and the run's log.
results/conditions_test.part*.json
results/conditions_test.log

# A later agent set's conditions-test working files (8 October 2026,
# conditions_test.py --set): one part per condition, merged into the set's own
# conditions_test.json.
results/conditions_*/conditions_test.part*.json
# x1_score.py's per-step logs; SCORE_LOG.txt beside them is the record.
results/x1_score/*.log
